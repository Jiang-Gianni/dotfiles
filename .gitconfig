[core]
	editor = nvim
[pull]
    rebase = true
[diff]
	tool = nvimdiff
[difftool "nvimdiff"]
	cmd = nvim -d \"$LOCAL\" \"$REMOTE\"
[difftool]
    prompt = false
[merge]
    tool = nvimdiff
[mergetool "nvimdiff"]
    cmd = nvim -d -c \"wincmd w\" \"$LOCAL\" \"$MERGED\" \"$REMOTE\"
[alias]
    jump = "~/.local/bin/git-jump"
[init]
    defaultBranch = main
[rebase]
	updateRefs = true
; [maintenance]
; "git maintenace start"
;     repo = {repo_path}
